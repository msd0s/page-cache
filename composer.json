{
    "name": "msd0s/page-cache",
    "description": "پکیج لاراول ذخیره سازی صفحه html رندر شده در دیتابیس",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "سعید آذریان",
            "email": "cmsnevis1404@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Msd0s\\PageCache\\": "src/"
        }
